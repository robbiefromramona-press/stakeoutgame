{
  "_comment": "Minimal SDXL txt2img workflow in ComfyUI API format. The __TOKENS__ are filled in by imagegen/run_comfy.py -- do not rename them. To use your own workflow instead: in ComfyUI enable Settings > Enable Dev mode, then Save (API Format), and replace the literal prompt/seed/size values in the exported file with these same tokens.",
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "__CKPT__" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__POSITIVE__", "clip": ["1", 1] }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__NEGATIVE__", "clip": ["1", 1] }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": "__WIDTH__", "height": "__HEIGHT__", "batch_size": "__BATCH__" }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "__SEED__",
      "steps": "__STEPS__",
      "cfg": "__CFG__",
      "sampler_name": "__SAMPLER__",
      "scheduler": "__SCHEDULER__",
      "denoise": 1.0,
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0]
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["5", 0], "vae": ["1", 2] }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "__PREFIX__", "images": ["6", 0] }
  }
}
